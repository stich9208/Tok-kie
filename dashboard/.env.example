# Static web/Vercel read gateway. Both values must match the desktop project's
# URL/key. QR v2 never embeds a project key; it carries only routing data and a
# five-minute one-time claim. The viewer still requires an authenticated member.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# HTTPS host placed into desktop-generated mobile pairing QR links.
NEXT_PUBLIC_WEB_APP_URL=https://your-tokkie-viewer.example

# OAuth client configuration and all durable credentials belong to Electron
# main/secure storage. They must never be exposed as NEXT_PUBLIC_* values.
