# Supabase Cloud Configuration (Optional)
# Leave blank to use local offline SQLite mode automatically
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Management OAuth (PKCE Standard - Client Secret Not Needed!)
# Register your OAuth App at: https://supabase.com/dashboard/account/me > OAuth Apps
# Redirect URI: tokkie://oauth/callback
SUPABASE_OAUTH_CLIENT_ID=your-oauth-client-id
# SUPABASE_OAUTH_CLIENT_SECRET=optional-for-legacy-web
